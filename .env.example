# === Zorunlu ===
# BotFather'dan aldığın token
TELEGRAM_TOKEN=
# Boş bırakırsan bota ilk /start yazan hesap sahibi olarak kaydedilir
ALLOWED_CHAT_ID=

# === Kadro / haber analizi (önerilir) ===
# https://aistudio.google.com/apikey adresinden ücretsiz anahtar
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# === Strateji (varsayılanlar önerilen değerlerdir) ===
BANKROLL=1000
KELLY_FRACTION=0.25
MAX_STAKE_PCT=0.03
MIN_STAKE=10
MIN_ODDS=1.40
MAX_ODDS=4.00
MIN_PROB=0.30
MIN_EV_HIGH=0.03
MIN_EV_MID=0.05
MIN_EV_LOW=0.08
MAX_EV=0.25
# Model harmanı Telegram'dan /agirlik ile ayarlanır (varsayılan: sadece piyasa)
STAT_MODEL=gol
# 1 = sadece ana pazarlar (MS, ÇŞ, Alt/Üst, KG, handikap) önerilir
CORE_ONLY=1
# 1 = korner/kart da önerilir (doğrulanmadı, önerilmez)
ALLOW_COUNT_MARKETS=0
# İstatistik kuponları (Banko + Günün İstatistik Kuponu); tutar kasanın bu oranı (0.01 = %1)
STAT_COUPONS=1
FUN_STAKE_PCT=0.01
# Oran avantajlı tekli seçimler ve ⚡ bildirimleri (Telegram'dan /deger ac|kapat)
VALUE_PICKS=0
# GitHub'dan güncelleme (/guncelle). Depo gizliyse token (sadece okuma yetkili) gerekir.
GITHUB_REPO=ssezenbay-cpu/iddaa-bot
GITHUB_TOKEN=

# === Zamanlama (Türkiye saati) ===
DAILY_REPORT_HOUR=10
DAYS_AHEAD=0
